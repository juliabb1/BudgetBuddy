generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  INSURANCE
  ENERGY
  INTERNET
  PHONE
  STREAMING
  FOOD
  TRANSPORT
  HEALTH
  EDUCATION
  SUBSCRIPTION
  OTHER
}

enum Cycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

model Contract {
  contractId String @id @default(cuid())
  userId          String
  name            String
  price           Decimal   @db.Decimal(10, 2)
  cycle           Cycle
  startDate       DateTime
  endDate         DateTime?
  debitDayOfMonth Int
  category        Category
  documents       Json?
  isActive        Boolean   @default(true)

  user            User      @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model User {
  userId        String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  contracts     Contract[] // Opposite relation field needed in Prisma
}