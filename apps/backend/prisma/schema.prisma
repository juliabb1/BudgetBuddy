generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  INSURANCE
  ENERGY
  INTERNET
  PHONE
  STREAMING
  FOOD
  TRANSPORT
  HEALTH
  EDUCATION
  SUBSCRIPTION
  OTHER
}

enum Cycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

model Contract {
  contractId String @id @default(cuid())
  userId          String
  name            String
  price           Decimal   @db.Decimal(10, 2)
  cycle           Cycle
  startDate       DateTime
  endDate         DateTime?
  debitDayOfMonth Int
  category        Category
  documents       Document[]
  isActive        Boolean   @default(true)

  user            User      @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model Document {
  documentId   String @id @default(cuid())
  contractId   String
  originalName String
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  data         Bytes  
  uploadedAt   DateTime @default(now())

  contract     Contract @relation(fields: [contractId], references: [contractId], onDelete: Cascade)

  @@index([contractId])
}

model User {
  userId        String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  contracts     Contract[] // Opposite relation field needed in Prisma
}
