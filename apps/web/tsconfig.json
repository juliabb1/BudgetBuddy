{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      ".prisma/*": ["../../node_modules/.prisma/*"],
      "@web/*": ["./*"],
      "@repo/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@repo/shared-types/*": ["../../packages/shared-types/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
